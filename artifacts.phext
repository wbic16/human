<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Level Editor · phext-edit</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<style>
  :root{
    --bg:#171717; --panel:#131313; --bar:#1c1c1c; --border:#2e2e2e;
    --text:#dedede; --dim:#9a9a9a; --coord:#d4a855; --active:#e8c547;
    --tile:#22304a; --empty:#182238; --sel:#1d4ed8;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);
       font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       font-size:16px;line-height:1.45}
  #topbar{height:42px;background:var(--bar);border-bottom:1px solid var(--border);
          display:flex;align-items:center;padding:0 16px;gap:14px}
  #topbar .brand{color:var(--coord);text-decoration:none;font-weight:bold}
  #topbar .back{margin-left:auto;color:var(--coord);text-decoration:none;
          padding:4px 12px;border:1px solid var(--coord);border-radius:6px;background:#2a2312}
  main{max-width:900px;margin:0 auto;padding:18px 16px 48px}
  h1{color:var(--coord);font-size:22px;margin:0 0 2px}
  .sub{color:var(--dim);margin:0 0 14px}
  .editor{display:flex;gap:0;background:#0b1220;border-radius:12px;overflow:hidden}
  /* vertical layer tabs */
  .tabs{display:flex;flex-direction:column;gap:4px;padding:10px 6px;background:#101a2e}
  .tab{writing-mode:vertical-rl;transform:rotate(180deg);
       background:#22304a;color:#cfe0ff;border:2px solid transparent;border-radius:8px;
       padding:14px 7px;cursor:pointer;font-size:15px;text-align:center;user-select:none}
  .tab:hover{background:#31497a}
  .tab.sel{border-color:var(--active);background:var(--sel);color:#fff}
  .tab.add{background:transparent;border:2px dashed #4a5f8a;color:var(--dim);font-weight:700}
  .stage{flex:1;padding:14px 16px}
  .layerbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
  .layerbar input.name{background:#1e1e1e;color:var(--text);border:1px solid var(--border);
       border-radius:7px;padding:7px 10px;font-size:16px;width:200px}
  .layerbar .del{background:none;border:1px solid var(--border);color:var(--dim);
       border-radius:7px;padding:6px 10px;cursor:pointer;font-size:13px}
  .palette{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
  .chip{min-width:44px;height:44px;padding:0 8px;display:flex;flex-direction:column;
       align-items:center;justify-content:center;gap:0;background:#22304a;color:#e8eefc;
       border:2px solid transparent;border-radius:8px;cursor:pointer}
  .chip .g{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:18px;line-height:1.1}
  .chip .l{font-size:10.5px;color:var(--dim);max-width:76px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chip.sel{border-color:var(--active)}
  .chip.erase{background:#2a2a2a}
  .addtile{display:flex;gap:5px;align-items:center}
  .addtile input{background:#1e1e1e;color:var(--text);border:1px solid var(--border);
       border-radius:7px;padding:8px;font-size:15px}
  .addtile input.ch{width:44px;text-align:center;font-family:ui-monospace,Menlo,Consolas,monospace}
  .addtile input.lb{width:110px}
  .smallbtn{background:var(--coord);color:#000;border:0;border-radius:7px;
       padding:8px 12px;font-size:14px;font-weight:600;cursor:pointer}
  .map{display:grid;grid-template-columns:repeat(12,44px);gap:4px}
  .cell{width:44px;height:44px;display:flex;align-items:center;justify-content:center;
       background:var(--tile);color:#e8eefc;border-radius:7px;cursor:pointer;
       font-family:ui-monospace,Menlo,Consolas,monospace;font-size:21px;
       border:2px solid transparent;user-select:none}
  .cell.empty{background:var(--empty);color:#3c4a6b}
  .cell:hover{background:#31497a}
  .cell.cursor{border-color:var(--active)}
  .bottombar{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:14px}
  .addr{font-family:ui-monospace,Menlo,Consolas,monospace;color:var(--coord);font-size:14.5px}
  .stat{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;color:var(--dim)}
  button.dl{background:var(--coord);color:#000;border:0;border-radius:8px;
       padding:10px 16px;font-size:15px;font-weight:600;cursor:pointer}
  a{color:#4dc9c9}
  footer{margin-top:26px;color:var(--dim);font-size:13.5px}
  @media (max-width:620px){ .map{grid-template-columns:repeat(12,26px)} .cell{width:26px;height:26px;font-size:14px} }
</style>
</head>
<body>
<div id="topbar">
  <a class="brand" href="/">💎 phext-edit</a>
  <span>Level Editor</span>
