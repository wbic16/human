<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Scrollspace — Exocortical Vision</title>
<style>
  @font-face{font-family:'Willbot Mono';src:url("/willbot-mono.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;height:100%;background:#04060e;overflow:hidden;font-family:ui-monospace,Menlo,Consolas,monospace;color:#cfe3ff}
  #view{position:absolute;inset:0;display:block;cursor:crosshair;touch-action:none}
  #hud{position:absolute;top:10px;left:12px;font-size:13px;line-height:1.5;pointer-events:none;text-shadow:0 1px 3px #000;max-width:60vw}
  #hud .crumb{color:#8fb7ff}
  #hud .coord{color:#ffd479;font-size:15px}
  #hud .hint{color:#7d8aa5;font-size:12px}
  #target{position:absolute;top:10px;right:12px;max-width:36%;text-align:right;font-size:13px;line-height:1.5;pointer-events:none;text-shadow:0 1px 3px #000}
  #target .t{color:#ffe9a8}
  #target .s{color:#7d8aa5;font-size:12px}
  #nav{position:absolute;top:52px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:5}
  #nav input{width:min(430px,52vw);background:rgba(8,16,36,.92);border:1px solid #3c5a8f;border-radius:8px;color:#ffe9a8;font-family:inherit;font-size:14px;padding:8px 10px;outline:none}
  #nav input:focus{border-color:#ffd479}
  #nav button,#readbtn,#rebindbtn{background:rgba(10,20,44,.92);border:1px solid #3c5a8f;border-radius:8px;color:#cfe3ff;font-family:inherit;font-size:13px;padding:8px 12px;cursor:pointer}
  #nav button:hover,#readbtn:hover,#rebindbtn:hover{border-color:#8fb7ff}
  #readbtn{position:absolute;top:52px;right:12px;z-index:5;display:none}
  #castwrap{position:absolute;left:50%;bottom:128px;transform:translateX(-50%);width:min(340px,80vw);display:none;z-index:6}
  #castlabel{text-align:center;font-size:12px;color:#ffe9a8;margin-bottom:4px;text-shadow:0 1px 3px #000}
  #castbar{height:12px;border:1px solid #5b7bb4;border-radius:6px;background:#0a1224;overflow:hidden}
  #castfill{height:100%;width:0%;background:linear-gradient(90deg,#3f7cff,#9fd0ff)}
  #fade{position:absolute;inset:0;background:#000;opacity:0;pointer-events:none;transition:opacity .45s}
  #bars{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);display:flex;flex-direction:column;gap:6px;align-items:center;z-index:5}
  .bar{display:flex;gap:5px}
  .slot{width:52px;height:52px;border:1px solid #3c5a8f;border-radius:8px;background:rgba(10,20,44,.85);color:#cfe3ff;font-family:inherit;cursor:pointer;padding:3px;display:flex;flex-direction:column;justify-content:space-between}
  .slot:hover{border-color:#8fb7ff}
  .slot .k{font-size:11px;color:#ffd479;text-align:left}
  .slot .a{font-size:9.5px;line-height:1.15;color:#b9d2ff;text-align:center}
  .slot.rebind{border-color:#ffd479;box-shadow:0 0 8px #ffd479}
  #rebindbtn{position:absolute;left:12px;bottom:196px;z-index:5;font-size:11.5px;padding:6px 9px}
  #rebindbtn.on{border-color:#ffd479;color:#ffd479}
  #help{position:absolute;left:12px;bottom:10px;font-size:11.5px;color:#7d8aa5;line-height:1.55;pointer-events:none;text-shadow:0 1px 3px #000;max-width:30vw}
  #msg{position:absolute;left:50%;top:104px;transform:translateX(-50%);font-size:14px;color:#ffe9a8;text-shadow:0 1px 4px #000;pointer-events:none;opacity:0;transition:opacity .3s;z-index:6;text-align:center;max-width:90vw}
  #authpanel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(430px,92vw);background:#070d1f;border:1px solid #3c5a8f;border-radius:12px;z-index:20;display:none;flex-direction:column;gap:12px;padding:22px 24px;box-shadow:0 12px 44px rgba(0,0,0,.65)}
  #authpanel h2{font-size:16px;color:#ffe9a8;margin:0;line-height:1.4}
  #authpanel p{font-size:13px;line-height:1.6;color:#b9d2ff;margin:0}
  #authpanel .auth-btn{display:block;width:100%;text-align:center;background:rgba(10,20,44,.92);border:1px solid #3c5a8f;border-radius:8px;color:#cfe3ff;font-family:inherit;font-size:14px;padding:10px 12px;cursor:pointer;text-decoration:none;margin:0 0 8px}
  #authpanel .auth-btn:hover{border-color:#ffd479;color:#ffe9a8}
  #authpanel .note{font-size:12px;color:#7d8aa5}
  #pad{position:absolute;right:10px;bottom:196px;display:none;z-index:5;grid-template-columns:repeat(3,52px);grid-template-rows:repeat(3,52px);gap:5px}
  #pad button{background:rgba(10,20,44,.85);border:1px solid #3c5a8f;border-radius:8px;color:#cfe3ff;font-family:inherit;font-size:17px;cursor:pointer}
  #pad button:active{border-color:#ffd479;color:#ffd479}
  #read{position:absolute;top:0;right:0;height:100%;width:min(560px,94vw);background:#070d1f;border-left:1px solid #3c5a8f;z-index:9;display:none;flex-direction:column;padding:18px 20px;overflow:auto}
  #read h2{font-size:16px;color:#ffe9a8;margin:0 0 4px;line-height:1.4;user-select:text}
  #read .meta{font-size:12px;color:#8fb7ff;margin-bottom:12px;user-select:text}
  #read .body{font-family:'Willbot Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;line-height:1.65;color:#dbe9ff;white-space:pre-wrap;user-select:text;word-break:break-word}
  #read .row{display:flex;gap:8px;margin:14px 0;flex-wrap:wrap}
  #read .row button,#read .row a{background:rgba(10,20,44,.92);border:1px solid #3c5a8f;border-radius:8px;color:#cfe3ff;font-family:inherit;font-size:13px;padding:8px 12px;cursor:pointer;text-decoration:none}
  #read .row button:hover,#read .row a:hover{border-color:#ffd479}
  #readclose{align-self:flex-end}
  /* Plane footer (task 26.9.10/11.7.14/7.7.8): the plane tagline is UI
     chrome, not scroll text — it lives in this bar, never in S.plane.
     Shown only on a plane (level 4); while it is up, body.onplane lifts
     the bottom chrome by the footer's measured height (--planefoot-h)
     so nothing overlaps it. Levels 0-3 are pixel-identical to before. */
  #planefoot{position:absolute;left:0;right:0;bottom:0;display:none;align-items:center;justify-content:space-between;gap:14px;padding:8px 14px;background:#070d1f;border-top:1px solid #3c5a8f;z-index:5;font-size:13.5px;line-height:1.45;color:#b9d2ff}
  #planefoot .pftag{min-width:0}
  #planefoot a{flex:none;background:rgba(10,20,44,.92);border:1px solid #3c5a8f;border-radius:8px;color:#cfe3ff;font-family:inherit;font-size:13px;padding:7px 12px;cursor:pointer;text-decoration:none}
  #planefoot a:hover{border-color:#ffd479;color:#ffe9a8}
  body.onplane #bars{bottom:calc(10px + var(--planefoot-h,52px))}
  body.onplane #help{bottom:calc(10px + var(--planefoot-h,52px))}
  body.onplane #castwrap{bottom:calc(128px + var(--planefoot-h,52px))}
  body.onplane #rebindbtn{bottom:calc(196px + var(--planefoot-h,52px))}
  body.onplane #pad{bottom:calc(196px + var(--planefoot-h,52px))}
  @media (max-width:760px){
    .slot{width:44px;height:44px}
    .slot .a{font-size:8.5px}
    #help{display:none}
    #target{max-width:44%}
    #hud{font-size:12px}
    #rebindbtn{bottom:auto;top:104px}
    body.onplane #rebindbtn{bottom:auto}
    #pad{display:grid}
    #castwrap{bottom:170px}
  }
</style>
