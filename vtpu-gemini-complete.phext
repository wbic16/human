// Manhattan distance sweep
macro_rules! manhattan_test {
    ($name:ident, $dim:expr, $v1:expr, $v2:expr, $expected:expr) => {
        #[test] fn $name() {
            let mut a = PhextCoord::zero();
            let mut b = PhextCoord::zero();
            a.set_dim($dim, $v1);
            b.set_dim($dim, $v2);
            assert_eq!(a.manhattan_distance(&b), $expected);
        }
    }
}

