    ($name:ident, $d:expr, $s:expr, $c:expr) => {
        #[test]
        fn $name() {
            let siw = SIW::new($d, $s, $c, PhextCoord::zero());
            assert_eq!(siw.d_op, $d);
            assert_eq!(siw.s_op, $s);
            assert_eq!(siw.c_op, $c);
        }
    };
}

