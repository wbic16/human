// Equality sweep
macro_rules! eq_test {
    ($name:ident, $dims:expr) => {
        #[test] fn $name() {
            let a = PhextCoord::new($dims);
            let b = PhextCoord::new($dims);
            assert_eq!(a, b);
        }
    }
}

