#[test] fn cost_1000() {
    let hw = HardwareCost::ranch_node();
    let br = BenchResult { label: "t".into(), ops: 1000, duration: Duration::from_millis(1), sentron_count: 40 };
    let ca = CostAnalysis::new(hw, br);
    assert!(ca.gops() >= 0.0);
}
#[test] fn cost_10000() {
