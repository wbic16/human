macro_rules! bench_result_test {
    ($name:ident, $ops:expr, $ms:expr) => {
        #[test]
        fn $name() {
            let br = BenchResult {
                label: stringify!($name).into(),
                ops: $ops,
                duration: Duration::from_millis($ms),
                sentron_count: 1,
            };
            assert!(br.ops_per_sec() > 0.0);
            assert!(br.ns_per_op() > 0.0);
            assert!(br.ops_per_cycle(4.0) > 0.0);
        }
    };
}

