            print(f"   Actual:    {self.results['multi_agent_sync']['speedup']:.0f}× faster than Raft")
            print(f"   Projected: {self.projections['multi_agent_sync_speedup']:.0f}× faster")
        
        print("\n" + "=" * 60)
        print("✅ Benchmark suite complete")
