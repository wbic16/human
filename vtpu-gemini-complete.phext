    let mut s: Vec<Sentron> = (0..40).map(|i| sentron(i, 9)).collect();
    let mut mem = Memory::new();
    let r = coop_execute(&mut s, &mut mem, &CoopConfig::default());
    assert_eq!(r.total_retired, 360);
}

