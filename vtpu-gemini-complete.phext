    // Single-pipe streams — vak should align with pipe type
    bench("D-only (Story → ↓Vaik)", d_stream(N));
    bench("S-only (Light → ↑Para)", s_stream(N));
    bench("C-only (balanced)",       c_stream(N));

    // Mixed pipes
