// ══════════════════════════════════════════════════

#[test] fn exec_csend_outbox() { let s = exec_one(DenseOp::DNOP, SparseOp::SNOP, CoordOp::CSEND{msg_reg:1,dest_sentron:5}); assert_eq!(s.outbox.len(), 1); assert_eq!(s.outbox[0], (5, 10)); }
