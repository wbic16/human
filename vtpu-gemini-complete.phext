    #[test]
    fn pack_unpack_roundtrip() {
        let weights = vec![1, -1, 0, 1, -1, -1, 0, 0, 1, 0];
        let packed = pack_trits(&weights);
        let unpacked = unpack_trits(packed[0], weights.len());
        assert_eq!(unpacked, weights);
    }

